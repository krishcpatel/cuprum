  "name": "Cuprum",
  "description": "Direct Apple Metal rendering backend for Minecraft 26.3 on macOS.",
  "authors": ["Krish C. Patel"],
  "contact": {},
  "license": "LGPL-3.0-only",
  "environment": "client",
